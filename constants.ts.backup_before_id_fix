  createHero2('h6_3','Trần Nhân Tông',76,6,'ally','Hoàng đế',
    'Trần Nhân Tông là vị hoàng đế anh minh nhất nhà Trần, lãnh đạo thắng lợi cả kháng chiến chống Mông-Nguyên lần 2 và lần 3. Sau khi nhường ngôi, ông xuất gia thành lập Thiền phái Trúc Lâm Yên Tử — dòng thiền thuần Việt đầu tiên.',
