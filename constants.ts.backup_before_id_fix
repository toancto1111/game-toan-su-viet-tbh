  createHero2('h7_17','Vũ Công Khanh',52,7,'ally','Tướng quân','Tướng quân thời chống Minh, có tài chỉ huy quân sự và chiến thuật.','Khinh Binh Đột Phá','Dùng khinh binh nhanh nhẹn phá vỡ hàng phòng thủ (+15%).'),
  createHero2('h7_18','Bùi Quý Hưu',53,7,'ally','Hào kiệt','Hào kiệt thời Minh thuộc, chiến đấu bảo vệ dân làng khỏi sự tàn bạo của quân xâm lược.','Thôn Làng Thủ Vệ','Bảo vệ thường dân cho toàn đội (+15% Phòng thủ).'),
