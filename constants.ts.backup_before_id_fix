  createHero2('h6_31','Nguyễn Hiền',67,6,'ally','Trạng nguyên',
    'Nguyễn Hiền là trạng nguyên nhỏ tuổi nhất lịch sử Việt Nam, đỗ đầu năm 13 tuổi dưới triều Trần. Ông là biểu tượng của sự thông minh xuất chúng từ nhỏ.',
    'Thần Đồng Kỳ Tài','Tài năng vượt tuổi tác, gây sát thương (134% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h6_32','Trần Quốc Tảng',57,6,'ally','Thân vương','Trần Quốc Tảng là con trai Trần Quốc Tuấn, có đóng góp trong kháng chiến chống Mông-Nguyên, dù không nổi bật như cha.','Hổ Tướng Chi Tử','Con trai của danh tướng, gây sát thương (114% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h6_33','Lý Chiêu Hoàng',45,6,'ally','Nữ hoàng',
    'Lý Chiêu Hoàng (1218 - 1278) là Nữ hoàng duy nhất trong lịch sử Đại Việt và là vị vua cuối cùng triều Lý. Dưới sự sắp đặt của Trần Thủ Độ, bà nhường ngôi cho Trần Thái Tông, khép lại 200 năm nhà Lý. Cuộc đời bà trải qua nhiều bi kịch trước khi tái giá và sống bình yên với danh tướng Lê Phụ Trần ở tuổi xế chiều.',
    'Nhượng Vị','Chấp nhận lùi bước vì đại cuộc, chuyển hóa sức mạnh bản thân để tăng cường toàn bộ chỉ số cho phe ta. (+10% Tấn công).'),
  createHero2('h6_34','An Tư Công Chúa',63,6,'ally','Hòa thân công chúa',
    'An Tư công chúa là một trong hai vị công chúa nổi tiếng nhất lịch sử nhà Trần. Năm 1285, bà được gả cho Trấn Nam vương Thoát Hoan làm kế hoãn binh, giúp đại quân nhà Trần rút lui an toàn. Sự hy sinh thầm lặng và kết cục bí ẩn của bà mãi là niềm xót xa trong lịch sử.',
    'Hòa Thân Hoãn Binh','Hy sinh bản thân, gây sát thương (82% Tấn công) và khống chế (tỷ lệ 30%) lên toàn bộ địch.'),
  createHero2('h6_35','Trần Thái Tổ',68,6,'ally','Thái thượng hoàng',
    'Trần Thái Tổ (1184 – 1234), tên húy Trần Thừa, là Thái thượng hoàng đầu tiên của nhà Trần. Khi con là Trần Thái Tông lên ngôi lúc còn nhỏ, ông cùng Thái sư Trần Thủ Độ nhiếp chính điều hành đất nước. Ông là một trong hai Thái thượng hoàng hiếm hoi chưa từng làm Hoàng đế trong lịch sử Việt Nam.',
    'Nhiếp Chính Hoàng Đình','Nhiếp chính ổn định triều đình cho toàn đội (+15% Phòng thủ).'),
  createHero2('h6_36','Lê Văn Hưu',65,6,'ally','Sử gia',
    'Lê Văn Hưu (1230–1322) là nhà sử học lỗi lạc đời nhà Trần, tác giả bộ "Đại Việt sử ký" — bộ quốc sử đầu tiên của Việt Nam (nền tảng cho bộ Đại Việt sử ký toàn thư sau này). Ông là Bảng nhãn đầu tiên của Đại Việt, đỗ khi 17 tuổi cùng khoa thi với Trạng nguyên Nguyễn Hiền.',
    'Đại Việt Sử Ký','Ghi chép và đúc kết kinh nghiệm qua từng hiệp đấu cho toàn đội (+10% Tấn công).'),
  createHero2('h6_37','Tuệ Tĩnh',78,6,'ally','Tiên thánh thuốc Nam',
    'Tuệ Tĩnh Thiền sư (1330 - 1400) là một danh y và thiền sư lỗi lạc sống vào cuối thời Trần. Với triết lý nổi tiếng "Nam dược trị Nam nhân" (thuốc Nam chữa bệnh cho người Nam), ông đã xây dựng nền tảng vững chắc cho y học cổ truyền dân tộc và được hậu thế suy tôn là tiên thánh của ngành thuốc Nam.',
    'Nam Dược Trị Nam Nhân','Sử dụng y thuật cổ truyền cho toàn đội (Hồi 16% Máu tối đa).'),
  createHero2('h6_38','Nguyễn Chế Nghĩa',49,6,'ally','Danh tướng',
    'Nguyễn Chế Nghĩa (1265–1341) là một danh tướng thời nhà Trần, nổi tiếng thông thạo thập bát ban võ nghệ. Ông là con rể vua Trần Anh Tông, làm quan trải qua 4 đời vua và có nhiều công lao to lớn với triều đình lẫn nhân dân. Sau khi ông mất, dân làng Kiêu Kỵ quê ông đã lập đền thờ tôn kính.',
    'Thập Bát Võ Nghệ','Sử dụng đa dạng binh khí, gây sát thương (98% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h6_39','Lý Đạo Tái',68,6,'ally','Thiền sư',
    'Lý Đạo Tái (1254-1334), đạo hiệu Huyền Quang, là thiền sư và nhà lãnh đạo Phật giáo Đại thừa thời Trần. Ông đỗ Trạng nguyên năm 1272, làm việc trong Viện Nội Hàn triều đình nổi tiếng thơ văn. Sau ông từ chức đi tu theo Trần Nhân Tông và trở thành Tổ thứ ba của Thiền phái Trúc Lâm Yên Tử.',
    'Trúc Lâm Tam Tổ','Kế thừa pháp môn Trúc Lâm cho toàn đội (Hồi 14% Máu tối đa).'),

  // ═══════════════════════════════════════ CHƯƠNG 7 ═══════════════════════════════════════
  createHero2('h7_1','Hồ Quý Ly',77,7,'ally','Thái sư',
    'Hồ Quý Ly là thái sư quyền lực cuối triều Trần, người soán ngôi lập nhà Hồ năm 1400. Ông tiến hành nhiều cải cách tiến bộ như in tiền giấy, hạn điền, cải cách hành chính. Nhưng cuối cùng thất bại trước cuộc xâm lược của nhà Minh do thiếu lòng dân.',
    'Cải Cách Khai Minh','Cải cách táo bạo, gây sát thương (154% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h7_2','Hồ Hán Thương',62,7,'ally','Hoàng đế','Hồ Hán Thương là con trai Hồ Quý Ly, hoàng đế thứ hai nhà Hồ, cùng cha chống lại quân Minh xâm lược nhưng thất bại, bị bắt đưa sang Trung Quốc.','Hồ Triều Thủ Vệ','Bảo vệ thành trì, gây sát thương (124% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h7_3','Hồ Nguyên Trừng',79,7,'ally','Tướng quân',
    'Hồ Nguyên Trừng là con trai Hồ Quý Ly, nhà chế tạo vũ khí thiên tài, người phát minh ra súng thần công và các loại vũ khí hiện đại cho quân đội nhà Hồ. Sau khi bị bắt sang Trung Quốc, ông phục vụ nhà Minh với tư cách kỹ sư vũ khí.',
    'Thần Công Bắc Lôi','Phóng đạn thần công, gây sát thương (158% Tấn công) cực lớn từ xa. (Mục tiêu: 1 mục tiêu địch).'),
  createHero2('h7_4','Trần Khát Chân',78,7,'ally','Tướng quân',
    'Trần Khát Chân là dũng tướng tài ba cuối nhà Trần, người đã đánh bại và giết chết vua Chế Bồng Nga của Chiêm Thành năm 1390 — kết thúc giai đoạn Chiêm Thành là mối đe dọa lớn nhất của Đại Việt. Ông sau đó mưu đồ chống Hồ Quý Ly và bị xử tử.',
    'Bãi Trúc Phục Kích','Phục kích trong bụi rậm, đòn tấn công bất ngờ gây sát thương (156% Tấn công) cao. (Mục tiêu: 1 mục tiêu địch).'),
  createHero2('h7_5','Trần Nguyên Hãn',80,7,'ally','Tướng quân',
    'Trần Nguyên Hãn là dũng tướng nhà hậu Trần, sau theo phò Lê Lợi trong khởi nghĩa Lam Sơn và lập nhiều chiến công. Ông chỉ huy trận Chi Lăng tiêu diệt Liễu Thăng. Tuy nhiên sau khi đất nước thống nhất, ông bị Lê Lợi nghi ngờ và giết hại.',
