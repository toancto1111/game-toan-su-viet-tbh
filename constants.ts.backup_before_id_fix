  createHero2('h6_13','Trần Nhật Duật',80,6,'ally','Chiêu Văn Vương',
    'Trần Nhật Duật là hoàng thân đa tài của nhà Trần, được biết đến như người thông minh nhất thời đại — tinh thông nhiều thứ tiếng, am hiểu văn hóa các dân tộc. Ông vừa là tướng tài vừa là nhà ngoại giao xuất sắc.',
    'Đa Ngữ Thần Giao','Hiểu địch như hiểu bạn, tăng hiệu quả phòng thủ (+25%) và tấn công.'),
  createHero2('h6_14','Chu Văn An',77,6,'ally','Quốc tử giám tư nghiệp',
    'Chu Văn An là nhà giáo vĩ đại nhất lịch sử Việt Nam, được xưng tụng là "Vạn thế sư biểu" (Người thầy muôn đời). Ông là tư nghiệp Quốc Tử Giám, dâng Thất trảm sớ đòi chém 7 tên quan gian nịnh. Không được chấp thuận, ông từ quan về ẩn dật.',
