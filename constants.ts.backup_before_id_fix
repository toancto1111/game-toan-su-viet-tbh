  createHero2('h7_20','Nguyễn Nhữ Cái',55,7,'ally','Tướng quân','Tướng quân tham gia kháng chiến chống Minh trong những năm đầu Minh thuộc.','Hậu Cần Dũng','Bảo vệ tuyến hậu cần, gây sát thương (110% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h7_21','Hồ Nhan',50,7,'ally','Hào kiệt','Hào kiệt thời Minh thuộc, dũng cảm chống lại sự bóc lột của quan lại phương Bắc.','Phản Kháng','Vùng lên bất ngờ, gây sát thương (100% Tấn công) lớn cho kẻ thống trị. (Mục tiêu: 1 mục tiêu địch).'),
  createHero2('h7_22','Trần Nguyên Đán',71,7,'ally','Quý tộc học giả',
    'Trần Nguyên Đán là quý tộc học giả cuối triều Trần, ông ngoại của Nguyễn Trãi. Ông nổi tiếng về thiên văn học và thơ văn, tiên đoán sự suy vong của nhà Trần.',
