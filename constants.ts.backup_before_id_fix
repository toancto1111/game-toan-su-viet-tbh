  createHero2('h7_6','Trần Ngỗi',66,7,'ally','Hậu Trần','Trần Ngỗi (Giản Định Đế) là vua của hậu Trần, lãnh đạo cuộc kháng chiến chống quân Minh xâm lược nhưng thiếu quyết đoán và thất bại.','Hậu Trần Khởi Phục','Tập hợp lực lượng tàn dư, gây sát thương (132% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h7_7','Trần Quý Khoáng',65,7,'ally','Hậu Trần','Trần Quý Khoáng (Trùng Quang Đế) là vua thứ hai của hậu Trần, tiếp tục kháng chiến chống Minh sau Giản Định Đế nhưng cũng thất bại.','Phục Quốc Chi Chí','Kiên trì kháng chiến dù gian khổ, gây sát thương (130% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h7_8','Đặng Dung',72,7,'ally','Tướng quân',
    'Đặng Dung là dũng tướng hậu Trần, từng suýt bắt được tướng giặc Trương Phụ nhà Minh nhưng không thành công. Ông là tác giả bài thơ "Cảm hoài" nổi tiếng: "Thù nước chưa xong đầu đã bạc, Dưới trăng mài kiếm mỗi đêm thu."',
    'Dưới Trăng Mài Kiếm','Kiên nhẫn rèn luyện trong đêm tối, tăng dần sức mạnh theo thời gian. (+10% Tấn công).'),
  createHero2('h7_9','Nguyễn Cảnh Chân',80,7,'ally','Tướng quân','Nguyễn Cảnh Chân là đại tướng dũng cảm của hậu Trần, chỉ huy nhiều trận đánh chống quân Minh. Ông hy sinh trong trận chiến bảo vệ hậu Trần.','Hậu Trần Trụ Đỡ','Bảo vệ toàn đội cho toàn đội (+20% Tấn công, +30 Nhuệ khí).'),
  createHero2('h7_10','Nguyễn Suý',67,7,'ally','Tướng quân','Tướng quân thời hậu Trần, có công trong các trận đánh chống quân Minh chiếm đóng.','Kỳ Binh Kỳ Trận','Dùng chiến thuật bất ngờ, gây sát thương (134% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h7_11','Nguyễn Phi Khanh',70,7,'ally','Nhà thơ yêu nước',
