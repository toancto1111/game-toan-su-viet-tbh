  createHero2('h6_20','Đoàn Nhữ Hài',71,6,'ally','Văn thần','Đoàn Nhữ Hài là quan văn tài ba, người soạn tờ biểu xin lỗi cho hoàng tử Trần Anh Tông khéo léo đến mức được vua Trần tha tội và trọng dụng.','Văn Chương Vũ Khí','Dùng tài văn chương gây bối rối, làm giảm tinh thần địch. (+20 Nhuệ khí).'),
  createHero2('h6_21','Trương Hán Siêu',66,6,'ally','Văn thần','Trương Hán Siêu là nhà thơ-quan văn nổi tiếng triều Trần, tác giả bài Phú sông Bạch Đằng bất hủ ca ngợi chiến thắng chống Mông-Nguyên.','Bạch Đằng Phú','Truyền cảm hứng từ lịch sử cho toàn đội (+20 Nhuệ khí).'),
  createHero2('h6_22','Nguyễn Địa Lô',70,6,'ally','Thần tiễn',
