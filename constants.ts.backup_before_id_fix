    'Hội An Thương Cảng','Phát triển thương mại và ngoại giao cho toàn đội (+10% Tấn công, +20 Nhuệ khí).'),
  createHero2('h9_3','Nguyễn Hữu Dật',72,9,'ally','Đại tướng',
    'Nguyễn Hữu Dật là đại tướng tài ba của các chúa Nguyễn, nhiều lần đánh lui quân Trịnh trong cuộc chiến tranh Trịnh-Nguyễn. Ông được xem là một trong những tướng giỏi nhất thế kỷ 17.',
    'Trịnh-Nguyễn Phân Tranh','Nắm rõ điểm yếu của đối phương sau nhiều lần giao tranh, gây sát thương (144% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h9_4','Nguyễn Bỉnh Khiêm',87,9,'ally','Trạng Trình',
