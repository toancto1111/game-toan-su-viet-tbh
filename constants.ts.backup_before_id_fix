  createHero2('h6_2','Trần Thánh Tông',78,6,'ally','Hoàng đế',
    'Trần Thánh Tông là hoàng đế thứ hai nhà Trần, lãnh đạo kháng chiến chống Mông-Nguyên lần hai năm 1285. Ông nổi tiếng về nhân từ, thương yêu dân, và thường nhường ngôi để cùng con chiến đấu bảo vệ đất nước.',
