    'Vân Đồn Phục Kích','Phục kích tuyến hậu cần địch, gây sát thương (162% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h6_10','Trần Quốc Toản',70,6,'ally','Hoài Văn Hầu',
