    'Di Ngôn Phụ Tử','Lời di nguyện truyền cho thế hệ sau cho toàn đội (+20 Nhuệ khí).'),
  createHero2('h7_12','Đặng Tất',71,7,'ally','Tướng quân','Đặng Tất là tướng tài của hậu Trần, cha của Đặng Dung. Ông lập nhiều chiến công nhưng bị giết oan bởi sự nghi ngờ của vua Giản Định Đế.','Trung Liệt Tướng Thần','Dù bị oan ức vẫn chiến đấu vì đại nghĩa, gây sát thương (142% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h7_13','Nguyễn Cảnh Dị',72,7,'ally','Tướng quân','Nguyễn Cảnh Dị là tướng tài cuối thời Trần, con của Nguyễn Cảnh Chân. Anh em họ Nguyễn Cảnh đều là trụ cột của hậu Trần trong kháng chiến chống Minh.','Nghĩa Phụ Tử Binh','Cha truyền con nối tinh thần chiến đấu cho toàn đội (+10% Tấn công, +20 Nhuệ khí).'),
  createHero2('h7_14','Hồ Tông Thốc',59,7,'ally','Văn thần','Học giả cuối triều Trần, từng phản đối việc soán ngôi của Hồ Quý Ly. Ông đại diện cho tiếng nói trung thực trong triều đình.','Sử Trực Bút','Ghi chép sự thật, gây sát thương (118% Tấn công) lên 1 mục tiêu địch..'),
