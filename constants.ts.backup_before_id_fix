  createHero2('h4_0','Đinh Bộ Lĩnh',95,4,'ally','Vạn Thắng Vương',
    'Đinh Bộ Lĩnh (Đinh Tiên Hoàng) là vị hoàng đế khai sáng nhà Đinh, người có công dẹp loạn 12 sứ quân, thống nhất đất nước, xưng hoàng đế và đặt tên nước là Đại Cồ Việt (968). Ông mở ra thời kỳ độc lập, tự chủ hoàn toàn cho dân tộc Việt Nam.',
    'Vạn Thắng Cờ Sậy','Hiệu triệu toàn bộ nghĩa quân Hoa Lư, gây sát thương (124% Tấn công) lên toàn bộ địch. Gây choáng (tỷ lệ 50%).'),
  createHero2('h4_1','Ngô Quyền',90,4,'ally','Ngô Vương',
    'Ngô Quyền là vị anh hùng dân tộc, người chấm dứt 1000 năm Bắc thuộc bằng trận Bạch Đằng lịch sử năm 938. Ông dùng mưu kế đóng cọc gỗ bọc sắt dưới sông Bạch Đằng, nhử thủy quân Nam Hán vào bẫy lúc triều xuống, đánh tan tác địch. Ông lên ngôi vương, mở ra kỷ nguyên độc lập lâu dài cho dân tộc.',
    'Bạch Đằng Cọc Sắt','Đặt bẫy địa hình, gây sát thương (180% Tấn công) cực lớn khi địch lọt vào.'),
  createHero2('h4_2','Lê Hoàn',91,4,'ally','Lê Đại Hành',
    'Lê Hoàn (Lê Đại Hành) là vị vua khai sáng nhà Tiền Lê. Ông đánh bại quân Tống xâm lược năm 981, bảo vệ nền độc lập vừa mới được xác lập. Ông cũng chỉ huy đại quân chinh phạt Chiêm Thành để bảo vệ bờ cõi phía nam. Được đánh giá là một trong những vị hoàng đế tài năng nhất lịch sử Việt Nam.',
    'Thiên Tử Chinh Phạt','Thân chinh dẫn đầu quân đội, gây sát thương (182% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h4_3','Nguyễn Bặc',81,4,'ally','Khai quốc công thần',
    'Nguyễn Bặc là một trong những công thần khai quốc của nhà Đinh, giúp Đinh Bộ Lĩnh thống nhất 12 sứ quân. Ông giữ chức Định Quốc Công, là một trụ cột của triều đình nhà Đinh.',
    'Đinh Quốc Tâm','Trung thành tuyệt đối với chủ tướng cho toàn đội (+25% Phòng thủ).'),
  createHero2('h4_4','Đinh Điền',80,4,'ally','Khai quốc công thần',
    'Đinh Điền là công thần khai quốc nhà Đinh, cùng Nguyễn Bặc và Lê Hoàn giúp Đinh Bộ Lĩnh dẹp 12 sứ quân, thống nhất đất nước sau loạn 12 sứ quân.',
    'Thập Nhị Sứ Quân Phá','Kinh nghiệm dẹp giặc loạn, gây sát thương (160% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h4_5','Lưu Cơ',82,4,'ally','Tướng quân',
    'Lưu Cơ là đại tướng tài ba thời Đinh-Tiền Lê, từng cầm quân đánh thắng nhiều trận, bảo vệ kinh đô Hoa Lư.',
    'Hoa Lư Thủ Vệ','Bảo vệ kinh thành tuyệt đối, tăng mạnh phòng thủ (+25%) khu vực.'),
  createHero2('h4_6','Dương Vân Nga',55,4,'ally','Thái hậu',
    'Dương Vân Nga là hoàng hậu nhà Đinh, sau trao hoàng bào cho Lê Hoàn lên ngôi để dẹp giặc Tống. Hành động của bà còn gây tranh cãi trong lịch sử — có người gọi là phản bội, nhưng nhiều nhà sử học hiện đại coi đây là quyết định hy sinh cá nhân vì lợi ích quốc gia.',
    'Nhường Triều','Hy sinh bản thân vì đại nghĩa cho toàn đội (+10% Tấn công).'),
  createHero2('h4_7','Đinh Toàn',51,4,'ally','Thiếu đế','Đinh Toàn là hoàng đế nhỏ tuổi của nhà Đinh, lên ngôi khi chưa đầy 6 tuổi sau khi vua cha Đinh Tiên Hoàng bị ám sát. Triều đình rối loạn, dẫn đến việc Dương Vân Nga trao quyền cho Lê Hoàn.','Ấu Chúa','Cần sự bảo hộ cho toàn đội (+15% Phòng thủ).'),
  createHero2('h4_8','Ngô Xương Xí',51,4,'ally','Sứ quân','Ngô Xương Xí là con trai Ngô Xương Văn, một trong 12 sứ quân thời loạn. Ông cát cứ vùng Bình Kiều cho đến khi bị Đinh Bộ Lĩnh dẹp yên.','Cát Cứ','phòng thủ (+15%) lãnh thổ cho toàn đội (+10% Tấn công, +15% Phòng thủ).'),
  createHero2('h4_9','Nguyễn Siêu',60,4,'ally','Sứ quân','Nguyễn Siêu là một trong 12 sứ quân thời loạn, chiếm cứ vùng Tây Phù Liệt. Ông là một trong những người đầu tiên khuất phục trước sức mạnh của Đinh Bộ Lĩnh.','Phù Liệt Trận','Chiến thuật phòng ngự linh hoạt, gây sát thương (120% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h4_10','Trần Lãm',61,4,'ally','Sứ quân','Trần Lãm là sứ quân cát cứ vùng Bố Hải Khẩu (Thái Bình), người đầu tiên ủng hộ Đinh Bộ Lĩnh lên ngôi, tạo nền tảng để thống nhất đất nước.','Bố Hải Thủy Binh','Chỉ huy thủy binh vùng cửa sông, gây sát thương (122% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h4_11','Nguyễn Thủ Tiệp',54,4,'ally','Sứ quân','Nguyễn Thủ Tiệp là một trong 12 sứ quân, chiếm cứ vùng Tiên Du (Bắc Ninh), cuối cùng thần phục Đinh Bộ Lĩnh và được giữ lại làm tướng.','Quy Phụ','Sau khi thần phục, gây sát thương (108% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h4_12','Kiều Công Hãn',73,4,'ally','Sứ quân','Kiều Công Hãn là sứ quân chiếm cứ vùng Phong Châu (Phú Thọ), dòng dõi Kiều Công Tiễn — kẻ giết Dương Đình Nghệ. Ông sau đó quy phục nhà Đinh và có công dẹp loạn.','Phong Châu Kỵ Binh','Chỉ huy kỵ binh vùng trung du, tốc độ và sức mạnh vượt trội. (+10% Tấn công). (+10% Tốc độ).'),
  createHero2('h4_13','Ngô Xương Văn',51,4,'ally','Thiên Sách Vương','Ngô Xương Văn là con trai Ngô Quyền, từng là vua nhà Ngô sau khi giết phản thần Dương Tam Kha, nhưng sau đó chia sẻ quyền lực với anh Ngô Xương Ngập, gây ra loạn 12 sứ quân.','Huynh Đệ Chi Tranh','Chiến đấu trong nội chiến, gây sát thương (102% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h4_14','Phạm Bạch Hổ',62,4,'ally','Sứ quân','Phạm Bạch Hổ (Phạm Phòng Át) là sứ quân chiếm cứ vùng Đằng Châu (Hưng Yên), nổi tiếng dũng cảm như hổ trắng. Ông quy phục Đinh Bộ Lĩnh và được phong tước.','Bạch Hổ Xuất Sơn','Sức mạnh hổ trắng, tấn công bất ngờ từ ẩn náu. (+10% Tấn công).'),
  createHero2('h4_18','Phạm Cự Lạng',71,4,'ally','Đại tướng','Phạm Cự Lạng là đại tướng thời Đinh-Tiền Lê, người đề xuất Dương Vân Nga trao hoàng bào cho Lê Hoàn khi giặc Tống tấn công. Ông có công lớn trong việc bảo vệ nền độc lập.','Trận Địa Quyết Sách','Đưa ra quyết định chiến lược, gây sát thương (142% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h4_20','Đinh Liễn',66,4,'ally','Hoàng tử',
    'Đinh Liễn là con trai trưởng của Đinh Tiên Hoàng, từng bị cha bắt giam làm con tin khi còn nhỏ. Sau lớn lên ông trở thành tướng giỏi, giúp vua cha thống nhất đất nước. Tuy nhiên ông cũng bị ám sát cùng với vua cha năm 979.',
    'Hoàng Tử Phục Thù','Chiến đấu vì danh dự gia tộc, tăng sát thương khi bị dồn vào góc tường. (Gây 132% sát thương Tấn công). (Mục tiêu: 1 mục tiêu địch).'),
  createHero2('h4_21','Trịnh Tú',74,4,'ally','Khai quốc công thần',
    'Trịnh Tú (924 - 979) là một khai quốc công thần nhà Đinh, thuộc "Tứ trụ triều Đinh" (Bặc, Điền, Cơ, Tú). Ông có công giúp Đinh Bộ Lĩnh dẹp loạn 12 sứ quân, thống nhất đất nước. Ông từng cùng Đinh Liễn đi giao bang với nhà Tống. Về sau, vì tận trung bảo vệ cơ nghiệp nhà Đinh nên ông bị hại.',
    'Tứ Trụ Triều Đinh','Phối hợp cùng các trụ cột khác tạo thế phòng thủ (+15%) vững chắc, gây sát thương (126% Tấn công) lên 1 hàng dọc địch.'),
  createHero2('h4_22','Lê Long Việt',61,4,'ally','Hoàng đế',
    'Tiền Lê Trung Tông (983–1005), tên thật Lê Long Việt, là hoàng đế thứ hai nhà Tiền Lê. Dù vâng di chiếu nối ngôi cha nhưng ông phải dẹp loạn anh em tranh giành suốt 8 tháng. Bi kịch thay, chỉ sau 3 ngày chính thức lên ngôi, ông bị em trai Lê Long Đĩnh sát hại, trở thành một trong những vị vua trị vì ngắn nhất lịch sử Việt Nam.',
    'Đế Vương Tam Nhật','Bùng cháy rực rỡ trong thời gian ngắn, tăng mạnh sát thương và tốc độ cho toàn đội trong 3 lượt đầu tiên. (Gây 122% sát thương Tấn công). (+10% Tốc độ). (Mục tiêu: 1 mục tiêu địch).'),
  createHero2('h4_23','Đinh Triều Quốc Mẫu',49,4,'ally','Quốc mẫu',
    'Đinh Triều Quốc Mẫu (dã sử gọi là Đàm Thị Thiềm) là mẹ của Vua Đinh Tiên Hoàng. Sau khi chồng là Đinh Công Trứ mất, bà đưa con nhỏ Đinh Bộ Lĩnh về quê nuôi dưỡng, hun đúc chí lớn giúp con dẹp loạn 12 sứ quân, lập ra triều Đinh và nhà nước Đại Cồ Việt. Bà được hậu thế tôn kính và lập đền thờ ở nhiều nơi.',
    'Dưỡng Dục Đế Vương','Công lao dưỡng dục bậc đế vương, gây sát thương (98% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h4_24','Ngô Xương Ngập',49,4,'ally','Thiên Sách Vương',
    'Ngô Xương Ngập (? - 954) là con trưởng của Ngô Quyền và là một vị vua nhà Ngô. Ông trị vì từ năm 951 đến 954 cùng với em trai là Ngô Xương Văn. Sử gọi chung thời kỳ hai anh em cùng trị vì là thời Hậu Ngô Vương.',
    'Hậu Ngô Đồng Trị','Kinh nghiệm cùng nhiếp chính, tăng cường sức mạnh và phòng thủ (+15%) khi có anh em hoặc đồng minh hoàng tộc cùng ra trận. (+10% Tấn công).'),

  // ═══════════════════════════════════════ CHƯƠNG 5 ═══════════════════════════════════════
  createHero2('h5_1','Lý Công Uẩn',82,5,'ally','Lý Thái Tổ',
    'Lý Công Uẩn (Lý Thái Tổ) là người sáng lập triều đại nhà Lý, dời đô từ Hoa Lư về Thăng Long năm 1010 — sự kiện lịch sử vĩ đại đặt nền móng cho Hà Nội ngàn năm. Chiếu dời đô của ông là kiệt tác văn học và tầm nhìn chính trị.',
    'Thăng Long Dời Đô','Chuyển dời trung tâm, gây sát thương (164% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h5_2','Lý Thường Kiệt',91,5,'ally','Thái úy',
    'Lý Thường Kiệt là danh tướng kiệt xuất nhà Lý, người chủ trương "tiên phát chế nhân" — chủ động đánh sang đất Tống để phá kế hoạch xâm lược. Ông đọc bài thơ thần bên sông Như Nguyệt để khích lệ quân sĩ, đánh tan quân Tống trong trận sông Cầu lịch sử. Tác giả bài thơ "Nam quốc sơn hà".',
    'Nam Quốc Sơn Hà','Đọc thơ thần khích lệ quân sĩ cho toàn đội (+20% Tấn công, +30 Nhuệ khí).'),
  createHero2('h5_3','Lý Thánh Tông',75,5,'ally','Hoàng đế',
    'Lý Thánh Tông là vị hoàng đế thứ ba nhà Lý, trị vì 1054–1072. Ông đổi tên nước từ Đại Cồ Việt thành Đại Việt — tên gọi tồn tại 400 năm. Ông thân chinh đánh Chiêm Thành năm 1069, mở rộng lãnh thổ về phía nam.',
    'Đại Việt Khai Quốc','Đổi tên nước cho toàn đội (+10% Tấn công, +20 Nhuệ khí).'),
  createHero2('h5_4','Tông Đản',73,5,'ally','Dân tộc tướng',
    'Tông Đản là tướng lĩnh người dân tộc thiểu số trong quân đội nhà Lý, có công trong các cuộc chiến chống Tống. Ông được Lý Thường Kiệt tin dùng trong chiến dịch đánh sang đất Tống năm 1075.',
    'Sơn Dân Chiến Pháp','Dùng chiến thuật vùng núi, gây sát thương (146% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h5_5','Lý Nhân Tông',74,5,'ally','Hoàng đế',
    'Lý Nhân Tông là hoàng đế thứ tư nhà Lý, trị vì 1072–1128 — thời kỳ dài nhất trong lịch sử nhà Lý. Dưới triều ông, nhà Lý đẩy lui thành công cuộc xâm lược của nhà Tống năm 1076–1077. Ông còn cho xây Văn Miếu Quốc Tử Giám.',
    'Văn Trị Võ Công','Kết hợp văn trị và võ công, gây sát thương (148% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h5_6','Lý Thái Tông',76,5,'ally','Hoàng đế',
    'Lý Thái Tông là hoàng đế thứ hai nhà Lý, con trai Lý Công Uẩn. Ông nổi tiếng về văn trị, ban hành bộ Luật Hình Thư đầu tiên của Việt Nam năm 1042, mở Khoa thi Thái học sinh.',
    'Hình Thư Trị Quốc','Dùng pháp luật điều phối quân đội cho toàn đội (+15% Phòng thủ).'),
  createHero2('h5_7','Mạc Hiển Tích',58,5,'ally','Trạng nguyên',
    'Mạc Hiển Tích là Trạng nguyên đầu tiên trong lịch sử Việt Nam, đỗ đầu khoa thi năm 1075 do Lý Nhân Tông tổ chức. Ông là người khai mở nền giáo dục khoa cử của Đại Việt.',
    'Văn Chiến Kế','Dùng mưu kế thông minh thay sức mạnh bạo lực, làm rối trận địch. (+10% Tấn công).'),
  createHero2('h5_8','Đào Cam Mộc',57,5,'ally','Khai quốc công thần',
    'Đào Cam Mộc là công thần khai quốc nhà Lý, người vận động cho Lý Công Uẩn lên ngôi sau khi Lê Long Đĩnh qua đời. Ông có công lớn trong việc chuyển giao triều đại từ Tiền Lê sang nhà Lý.',
    'Lập Đế Đại Nghĩa','Chọn minh chủ, gây sát thương (114% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h5_10','Sư Vạn Hạnh',81,5,'ally','Thiền sư',
    'Thiền sư Vạn Hạnh là nhà sư, chính khách và tiên tri tài ba thời Tiền Lê - Lý. Ông là thầy học và người nuôi dưỡng Lý Công Uẩn, tiên đoán và hậu thuẫn cho Lý Công Uẩn lên ngôi vua. Được xem là một trong những cố vấn vĩ đại nhất lịch sử Việt Nam.',
    'Thiền Ngữ Tiên Tri','Tiên đoán trận thế, gây sát thương (162% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h5_11','Khuông Việt',72,5,'ally','Quốc sư',
    'Khuông Việt (Ngô Chân Lưu) là Quốc sư của vua Đinh Tiên Hoàng và Tiền Lê, nhà sư kiêm chính khách nổi tiếng. Ông soạn bài biểu ngoại giao trả lời nhà Tống, bảo vệ thể diện quốc gia.',
    'Ngoại Giao Bút Kiếm','Dùng ngoại giao làm vũ khí, gây sát thương (144% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h5_12','Pháp Thuận',61,5,'ally','Thiền sư','Thiền sư Pháp Thuận là cố vấn tâm linh và chính trị cho các vua thời Đinh-Tiền Lê, nổi tiếng với bài thơ "Quốc tộ" tiên đoán sự thịnh vượng của đất nước.','Tâm Linh Lực','Sức mạnh tâm linh cho 1 đồng minh (Hồi 12% Máu tối đa). Đồng thời: +20 Nhuệ khí, +10% Tấn công.'),
  createHero2('h5_14','Lý Đạo Thành',74,5,'ally','Thái phó',
    'Lý Đạo Thành là đại thần tài ba triều Lý, giữ chức Thái phó phụ chính cho Lý Nhân Tông. Ông có công lớn trong việc xây dựng hệ thống hành chính và giáo dục của Đại Việt.',
    'Phụ Chính Đại Thần','Phụ trợ chủ tướng cho toàn đội (+10% Tấn công, +20 Nhuệ khí).'),
  createHero2('h5_15','Nguyên Phi Ỷ Lan',70,5,'ally','Nhiếp chính',
    'Nguyên Phi Ỷ Lan (Lê Thị Yến) là phi tần tài ba của Lý Thánh Tông, xuất thân bình dân. Bà từng nhiếp chính thành công trong khi vua đi chinh phạt Chiêm Thành, điều hành đất nước tài tình. Được xem là một trong những phụ nữ quyền lực nhất lịch sử Việt Nam.',
    'Chăm Tằm Dệt Cửi','Kiên nhẫn xây dựng thế trận vững chắc cho toàn đội (+15% Phòng thủ).'),
  createHero2('h5_21','Tô Hiến Thành',85,5,'ally','Thái úy / Tể tướng',
    'Tô Hiến Thành là đại thần phụ chính tài năng và đức độ cuối cùng của nhà Lý. Ông cùng Lý Anh Tông dẹp loạn, mở mang bờ cõi Tây bắc, chống quân Khmer và Chiêm Thành. Sự nghiệp quan văn của ông hiển hách không kém với công lao khai hoang lấn biển ven biển Vịnh Bắc Bộ.',
    'Chính Mưu Lấn Biển','Tăng mạnh phòng thủ (+25%) và hồi máu (Hồi 17% Máu tối đa) cho toàn quân cho toàn đội (Hồi 17% Máu tối đa). Đồng thời: +25% Phòng thủ.'),
  createHero2('h5_22','Lê Văn Thịnh',65,5,'ally','Thái sư',
    'Lê Văn Thịnh (1038–1096) là người đỗ đầu khoa thi đầu tiên của Nho học Việt Nam. Bằng tài ngoại giao xuất chúng năm 1084, ông buộc nhà Tống trả lại 6 huyện 3 động thuộc châu Quảng Nguyên. Cuộc đời ông kết thúc bi thảm sau "Vụ án hồ Dâm Đàm" oan khuất.',
    'Ngoại Giao Đòi Đất','Tài biện luận sắc bén, gây sát thương (130% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h5_23','Lê Phụng Hiểu',68,5,'ally','Đô thống',
    'Lê Phụng Hiểu (982? - 1059?) là võ quan cao cấp, giữ chức Đô thống chỉ huy quân đội, phụng sự 3 triều vua đầu nhà Lý. Nổi tiếng với sức khỏe muôn địch và nghệ danh Đô Bưng, ông có công rất lớn dẹp loạn Tam vương, phò Thái tử Lý Phật Mã lên ngôi (Lý Thái Tông).',
    'Đô Bưng Đỉnh Lực','Phát huy sức mạnh cơ bắp phi thường, giáng đòn chí mạng phá vỡ phòng tuyến của địch. (+15% Phòng thủ). (+10% Tấn công).'),
  createHero2('h5_24','Lý Quốc Sư',78,5,'ally','Quốc sư',
