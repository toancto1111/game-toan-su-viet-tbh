  createHero2('h6_26','Trần Thị Dung',72,6,'ally','Hoàng hậu','Trần Thị Dung là hoàng hậu, người vợ quan trọng của Trần Thủ Độ, có đóng góp lớn trong việc thiết lập và củng cố triều Trần.','Nội Trị Hậu Cần','Quản lý hậu cần xuất sắc cho toàn đội (+10% Tấn công, +20 Nhuệ khí).'),
  createHero2('h6_27','Nguyễn Khoái',64,6,'ally','Tướng quân','Nguyễn Khoái là dũng tướng trong kháng chiến chống Mông-Nguyên lần thứ ba, có công lớn trong trận Hàm Tử.','Hàm Tử Xung Kích','Xung phong từ phía sau, gây sát thương (128% Tấn công) bất ngờ cho địch.'),
  createHero2('h6_28','Dã Tượng',70,6,'ally','Gia thần',
