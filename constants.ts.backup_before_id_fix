/** Trả về đường dẫn ảnh local cho hero. Nếu không có → dùng ảnh mặc định. */
const getHeroImage = (id: string, faction: 'ally' | 'enemy'): string => {
  const folder = faction === 'ally' ? 'allies' : 'enemies';
  // Thử các định dạng phổ biến: .png, .jpg, .jpeg, .webp
  // Vite/browser sẽ load file đúng nếu tồn tại
  // Trả về đường dẫn .png trước; nếu muốn dùng .jpg thì đổi tên file tương ứng
  return `./heroes/${folder}/${id}.png`;
};

/** Ảnh mặc định khi ảnh riêng chưa có */
export const DEFAULT_ALLY_IMG  = './heroes/default_ally.png';
export const DEFAULT_ENEMY_IMG = './heroes/default_enemy.png';

const getRarityByStat = (stat: number): Rarity => {
  if (stat >= 90) return Rarity.UR;
  if (stat >= 80) return Rarity.SSR;
  if (stat >= 70) return Rarity.SR;
  if (stat >= 60) return Rarity.R;
  return Rarity.C;
};

const determineRoleAndScope = (title: string, skillDesc: string): { role: 'Tiên phong' | 'Sát thủ' | 'Hỗ trợ' | 'Khống chế' | 'Chiến tướng', targetScope: 'single' | 'front_row' | 'back_row' | 'column' | 'all' } => {
  const lowerDesc = skillDesc.toLowerCase();
  const lowerTitle = title.toLowerCase();
  
  let role: 'Tiên phong' | 'Sát thủ' | 'Hỗ trợ' | 'Khống chế' | 'Chiến tướng' = 'Sát thủ';
  let targetScope: 'single' | 'front_row' | 'back_row' | 'column' | 'all' = 'single';
  
  if (lowerDesc.includes('hồi máu') || lowerDesc.includes('hồi phục') || lowerTitle.includes('tiên mẫu') || lowerTitle.includes('quốc mẫu') || lowerDesc.includes('tăng phòng thủ toàn đội')) {
    role = 'Hỗ trợ';
  } else if (lowerDesc.includes('giáp') || lowerDesc.includes('phòng thủ') || lowerTitle.includes('tiên phong') || lowerDesc.includes('kiên cố') || lowerDesc.includes('chịu đòn')) {
    role = 'Tiên phong';
  } else if (lowerDesc.includes('choáng') || lowerDesc.includes('làm chậm') || lowerDesc.includes('giảm tốc') || lowerDesc.includes('đóng băng') || lowerDesc.includes('phá trận')) {
    role = 'Khống chế';
  } else if (lowerTitle.includes('chủ tướng') || lowerTitle.includes('vua') || lowerTitle.includes('vương') || lowerTitle.includes('đế')) {
    role = 'Chiến tướng';
  }
  
  if (lowerDesc.includes('diện rộng') || lowerDesc.includes('toàn bộ') || lowerDesc.includes('tất cả')) {
    targetScope = 'all';
  } else if (lowerDesc.includes('xuyên') || lowerDesc.includes('cột') || lowerDesc.includes('dọc')) {
    targetScope = 'column';
  } else if (lowerDesc.includes('hàng') || lowerDesc.includes('ngang')) {
    targetScope = 'front_row'; 
  }
  
  return { role, targetScope };
};


const toSlug = (str: string): string => {
  return str.toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/đ/g, 'd')
    .replace(/[^a-z0-9 ]/g, '')
    .replace(/\s+/g, '_');
};

const createHero = (id: string, name: string, stat: number, chapter: number, faction: 'ally' | 'enemy', title: string = 'Hào kiệt'): Hero => {
  const inferredTitle = stat >= 90 ? 'Chủ tướng' : (stat >= 80 ? 'Danh tướng' : title);
  const skillDesc = 'Gây sát thương dựa trên chỉ số cơ bản.';
  const { role, targetScope } = determineRoleAndScope(inferredTitle, skillDesc);
  return {
    id, name, title: inferredTitle, rarity: getRarityByStat(stat),
    overall: stat, atk: stat, def: stat - 5, spd: 100 + (stat % 20),
    hp: stat * 60, maxHp: stat * 60,
    morale: 0, initialMorale: stat >= 90 ? 50 : 25,
    star: 1, fragments: 0, description: `Nhân vật lịch sử thuộc chương ${chapter}.`,
    skillName: 'Chiến thuật quân sự', skillDesc,
    role, targetScope,
    skillVideoUrl: `/videos/${toSlug(name)}.mp4`,
    image: getHeroImage(id, faction), faction, chapter
  };
};

