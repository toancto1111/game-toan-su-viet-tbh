  createHero2('h6_15','Phạm Sư Mạnh',61,6,'ally','Văn thần','Học trò xuất sắc của Chu Văn An, làm quan to dưới triều Trần, nổi tiếng về văn chương và trị quốc.','Văn Khí Vũ Trận','Lời văn như gươm, gây sát thương (122% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h6_18','Lê Phụ Trần',72,6,'ally','Tướng quân','Lê Phụ Trần là dũng tướng nhà Trần, nổi tiếng trong kháng chiến chống Mông-Nguyên lần thứ nhất, từng cứu vua Trần Thái Tông khỏi vòng vây của địch.','Cứu Giá','Bảo vệ chủ tướng khỏi nguy hiểm, gây sát thương (144% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h6_19','Mạc Đĩnh Chi',70,6,'ally','Trạng nguyên',
