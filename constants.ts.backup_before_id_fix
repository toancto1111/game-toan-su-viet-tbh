  createHero2('h2_9','Lê Chân',75,2,'ally','Nữ tướng',
    'Lê Chân là nữ tướng trong khởi nghĩa Hai Bà Trưng, người sáng lập vùng đất An Biên (Hải Phòng ngày nay). Bà chiêu mộ nghĩa quân, lập trại An Biên và trở thành tướng thân cận của Trưng Trắc. Hải Phòng hiện có đền thờ Nữ tướng Lê Chân và đặt tên nhiều đường phố, quận theo tên bà.',
