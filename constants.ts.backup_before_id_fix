    'Sấm Trạng Tiên Đoán','Tiên tri chính xác, gây sát thương (174% Tấn công) lên 1 mục tiêu địch..'),
  createHero2('h9_5','Nguyễn Kim',80,9,'ally','Thái sư',
    'Nguyễn Kim là đại thần nhà Hậu Lê, người khôi phục nhà Lê sau khi bị Mạc Đăng Dung chiếm ngôi. Ông là thủy tổ của dòng họ chúa Nguyễn và chúa Trịnh, cha của Nguyễn Hoàng và nhạc phụ của Trịnh Kiểm.',
